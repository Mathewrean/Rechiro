# M-Pesa Daraja API Configuration
# Get these from https://developer.safaricom.co.ke/

# Consumer Key from your app on Safaricom Developer Portal
MPESA_CONSUMER_KEY=your_consumer_key_here

# Consumer Secret from your app on Safaricom Developer Portal
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Business Short Code (usually 5-6 digits, e.g., 123456)
MPESA_BUSINESS_SHORT_CODE=your_business_short_code

# Passkey from your app (get from developer portal)
MPESA_PASSKEY=your_passkey_here

# Callback URL - must be publicly accessible for production
# For local testing, use ngrok: https://your-ngrok-url.ngrok-free.dev/api/mpesa/callback/
# For Railway production: https://rechiro-production.up.railway.app/api/mpesa/callback/
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.dev/api/mpesa/callback/

# Base URL - use sandbox for testing, production for live
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Email Configuration (for production)
# Console email backend for local development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings for production (Railway often blocks standard ports, consider SendGrid/Mailgun)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Google OAuth Configuration
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Django Settings
SECRET_KEY=1234
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Security settings (enable for HTTPS production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgres://user:password@localhost/dbname

# Admin credentials for production (used in migration)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_on_production

# Site URL for Open Graph metadata
SITE_URL=https://your-production-url.up.railway.app

# WhatsApp Business Number (for customer support)
WHATSAPP_NUMBER=254701618286
